#include<stdio.h>

void selectionsort(int ar[],int size)
{
    for(int step=0;step<size-1;step++)
    {
        int min_idx=step;
        for(int i=step;i<size;i++)
        {
            if(ar[min_idx]>ar[i]) min_idx=i;
        }
        int temp=ar[step];
        ar[step]=ar[min_idx];
        ar[min_idx]=temp;
    }
}

int main(){
  int ar[5]=3,67,32,32,1;
  selectionsort(ar,5);
  return 0;
}
