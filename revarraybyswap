#include<iostream>
using namespace std;
int ar[5]={1,2,3,4,5};


void revarray(int ar[],int sz)
{
    int start=0;
    int end=sz-1;
    while(start!=end)
    {
        swap(ar[start],ar[end]);
        start++;
        end--;
    }
}
int main()
{
    
    revarray(ar,5);
    for(int i=0;i<5;i++)
    {
        cout<<ar[i];
    }
    
    return 0;

}
