amount=10000

def balance():
    print("Current Balance::",amount)

def deposit():
    
    global amount
    add=float(input("Enter amount to deposit::"))
    amount+=add
    print("Current Balance::",amount)
    
def withdraw():
    
    global amount
    sub=float(input("Enter amount to withdraw::"))
    amount-=sub
    print("Current Balance::",amount)

