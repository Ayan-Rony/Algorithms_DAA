#include<stdio.h>
int main()
{
    int b=7,temp;
    int a[10]={1,2,3,4,5,8,4};
    int k=3;
    int n=k%b;
    for(int i=0,j=6;i<j;i++,j--)
    {
        temp=a[i];
        a[i]=a[j];
        a[j]=temp;

    }
    for(int i=0,j=n-1;i<j;i++,j--)
    {
        temp=a[i];
        a[i]=a[j];
        a[j]=temp;

    }
    for(int i=n,j=6;i<j;i++,j--)
    {
        temp=a[i];
        a[i]=a[j];
        a[j]=temp;

    }

    for(int i=0;i<7;i++)
    {
        printf("\n%d",a[i]);
    }
    return 0;
}
