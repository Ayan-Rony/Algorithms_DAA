
#include<stdio.h>
#include<stdlib.h>
struct node {
    int data;
    struct node *link;
};
void delete_middle(struct node* head,int position){
    struct node *temp= head;
    for(int i=2; i< position; i++) {
      if(temp->link!=NULL) {
        temp = temp->link;
      }
    }
    
    temp->link = temp->link->link;
}

int main(){
  delete_middle(head,3);
  return 0;
}
