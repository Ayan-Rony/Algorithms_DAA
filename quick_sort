#include<stdio.h>

int partition(int ar[],int low,int high)
{
    int pivot=ar[high];
    int i=low-1;
    for(int j=low;j<high;j++)
    {
        if(ar[j]<=pivot)
        {
            i++;
            int temp=ar[i];
            ar[i]=ar[j];
            ar[j]=temp;
            
        }
    }
    int temp=ar[i+1];
    ar[i+1]=ar[high];
    ar[high]=temp;
    return (i+1);
}

void quicksort(int ar[],int low,int high)
{
    if(low<high)
    {
        int pi=partition(ar,low,high);
        quicksort(ar,low,pi-1);
        quicksort(ar,pi+1,high);
    }
}

int main(){
  int ar[5]={3,54,23,54,12};
  quicksort(ar,0,5);
  return 0;
}


