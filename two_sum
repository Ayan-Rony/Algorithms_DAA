#include<iostream>
using namespace std

vector<int> twoSum(vector<int>& nums, int target) 
    {
        vector<int> x;
        
        for(int i=0;i<nums.size();i++){
            for(int j=i+1;j<nums.size();j++){
                if(nums[i]+nums[j]==target){
                    x.push_back(i);
                    x.push_back(j);
                    break;
                }
                
            }
        }
        return x;
    }

int main(){
  vector<int> a=[{2,7,11,15};
  vector<int> q;
  int target=9;
  a=twosum(q,target);
  cout<<a<<endl;
  return 0;
}
